####################################
# APP
####################################
APP_NAME=TrendZone AI OS
VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

####################################
# DATABASE
####################################
DATABASE_URL=sqlite:///./trendzone.db

####################################
# CORS / URLS
####################################
# Origens permitidas (separadas por virgula) — inclua seu dominio aqui
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://SUA_URL_FRONTEND
FRONTEND_URL=http://127.0.0.1:5173

# URL publica do backend, usada para montar os links de rastreio (/go/{codigo})
# compartilhados nas redes sociais. Em producao DEVE ser o dominio publico
# (ex: https://app.trendzone.app), nunca localhost/IP interno.
APP_BASE_URL=http://127.0.0.1:8000

####################################
# JWT
####################################
SECRET_KEY=<GERE_UMA_CHAVE_SECRETA_FORTE_AQUI>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

####################################
# LOG
####################################
LOG_LEVEL=INFO

####################################
# SHOPEE
####################################
SHOPEE_GRAPHQL_URL=<URL_API_SHOPEE>
SHOPEE_APP_ID=<SEU_APP_ID_SHOPEE>
SHOPEE_SECRET=<SEU_SECRET_SHOPEE>
SHOPEE_ACCESS_TOKEN=<SEU_ACCESS_TOKEN_SHOPEE>
SHOPEE_REFRESH_TOKEN=

# Facebook Page (para postagem automatica pelo bot de divulgacao)
# FACEBOOK_PAGE_ID: ID numerico da pagina (em Configuracoes > Sobre da pagina, ou via Graph API Explorer)
# FACEBOOK_PAGE_TOKEN: Token de Acesso de Pagina de longa duracao, gerado no Meta for Developers
FACEBOOK_PAGE_ID=<ID_DA_SUA_PAGINA_FACEBOOK>
FACEBOOK_PAGE_TOKEN=<SEU_TOKEN_DE_ACESSO_DE_PAGINA>

####################################
# OPENROUTER
####################################
OPENROUTER_API_KEY=<SUA_CHAVE_OPENROUTER>
OPENROUTER_MODEL=<MODELO_OPENROUTER>

####################################
# LM STUDIO
####################################
LMSTUDIO_URL=<URL_LM_STUDIO>
LMSTUDIO_MODEL=<MODELO_LM_STUDIO>

####################################
# REDIS
####################################
REDIS_URL=<URL_REDIS>

####################################
# RABBITMQ
####################################
RABBITMQ_URL=<URL_RABBITMQ>
